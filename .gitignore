# ==============================================================
# .gitignore
# ------------------------------------------------------------
# ここに書いたファイル・フォルダは、GitHubにpushする対象から
# 除外されます(「git add」しても無視されます)。
# 秘密の情報や、実行するたびに作り直せるファイルを入れています。
# ==============================================================

# ---- 秘密の情報(絶対にGitHubへ上げてはいけないもの) ----
.env

# ---- 実行すると自動生成されるファイル・フォルダ(コードだけあれば再現できる) ----
data/
chart.png
candle_chart.png
predict_chart.png

# ---- Pythonが自動生成するキャッシュファイル ----
__pycache__/
*.pyc

# ---- 仮想環境フォルダ(venvを使う場合。使っていなければ無視してOK) ----
venv/
.venv/

# ---- エディタ・OSが自動生成するファイル ----
.vscode/
.DS_Store
